{
    "name": "theunwindfront/laravel-blade-variants",
    "description": "Tailwind CSS v4 plugin & Blade components for native, browser-driven variant styling.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sagar Pansuriya",
            "email": "pansuriya.sagar94@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Theunwindfront\\BladeVariants\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Theunwindfront\\BladeVariants\\BladeVariantsServiceProvider"
            ]
        }
    }
}
